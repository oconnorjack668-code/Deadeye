    { "id": "dark", "about": "a dim gym: darker, flatter, grainy", "vf": "eq=brightness=-0.16:contrast=0.8:saturation=0.8,noise=alls=10:allf=t" },
    { "id": "washed", "about": "bright windows behind: low contrast, lifted shadows", "vf": "eq=contrast=0.6:brightness=0.14:gamma=1.25" },
    { "id": "fps15", "about": "a phone scoring 15 frames a second", "vf": "fps=15", "fps": 15 },
    { "id": "fps10", "about": "a slow phone scoring 10 frames a second", "vf": "fps=10", "fps": 10 },
    {
      "id": "shake",
      "about": "a wobbly mount: the picture drifts up to about 0.6% each way",
      "vf": "crop=w=iw*0.96:h=ih*0.96:x=iw*0.02+iw*0.006*sin(2*PI*t*0.7):y=ih*0.02+ih*0.006*cos(2*PI*t*0.45),scale=trunc(iw/0.96/2)*2:trunc(ih/0.96/2)*2",
      "rimCrop": 0.02
    },
    { "id": "hard", "about": "small, dim and slow together", "vf": "scale=trunc(iw/4)*2:trunc(ih/4)*2,eq=brightness=-0.16:contrast=0.8:saturation=0.8,noise=alls=10:allf=t,fps=15", "fps": 15 }
  ]
