# Deadeye environment variables
# Copy to .env.local and fill in. Every name here is read somewhere in src/ -
# if you add a variable, add it here too.

# ---------------------------------------------------------------------------
# Supabase (required - the app cannot start without these)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS - never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Owner entitlement (required)
# The account with this email gets the server-enforced `owner` role: unlimited
# AI credits, Pro features, and the admin screens. Checked in src/lib/auth.ts.
# ---------------------------------------------------------------------------
OWNER_EMAIL=you@example.com
# Test logins (comma separated) to leave out of the player funnel at
# /admin/funnel, so test sign-ups do not count as players. Optional.
TEST_ACCOUNT_EMAILS=

# ---------------------------------------------------------------------------
# AI coach (optional - every AI feature shows an honest "not configured"
# state when AI_API_KEY is absent, and never fabricates output)
#
# AI_PROVIDER accepts "anthropic" or "openai". If you leave it blank it is
# worked out from the key: sk-ant-... means anthropic, sk-... means openai.
# Set it explicitly if you use a proxy whose keys are not in either shape.
#
# AI_MODEL defaults to claude-sonnet-5 for anthropic, gpt-4o-mini for openai.
#
# Using an OpenAI key? Either leave AI_PROVIDER blank or set it to "openai".
# Pairing an OpenAI key with AI_PROVIDER=anthropic is refused at startup,
# because the Anthropic API answers that with "401 invalid x-api-key", which
# looks like a bad key rather than the wrong provider.
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# Stripe (optional - billing stays completely inert until both the secret key
# and a monthly price id are set; see stripeConfigured() in src/lib/stripe.ts)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# The founder price (€4.99/month) founding members check out at. If unset they
# get the normal monthly price. See src/lib/stripe.ts monthlyPriceFor().
STRIPE_FOUNDER_MONTHLY_PRICE_ID=

# ---------------------------------------------------------------------------
# Founding member offer (src/lib/founding.ts). Open until 100 players have
# claimed it; set to true to close it early. Claims already made are kept.
# ---------------------------------------------------------------------------
FOUNDING_OFFER_CLOSED=

# ---------------------------------------------------------------------------
# Web push reminders (optional - generate with: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Scheduled jobs (required for the reminder and weekly-report crons; the
# routes reject any request without this bearer token)
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Who runs Deadeye (needed before launch - the GDPR and EU consumer law both
# require the privacy policy and terms to name the person responsible and an
# address). The adult who holds the Stripe and Google Play accounts.
# See src/lib/legal.ts.
# ---------------------------------------------------------------------------
LEGAL_NAME=
LEGAL_ADDRESS=

# ---------------------------------------------------------------------------
# Email (needed before launch). Sends parent approval emails to parents of
# under-16s, and the receipt when someone withdraws from Pro. Without it,
# parents approve straight from the link, with no email check.
# Resend only delivers to other people once the sending domain is verified,
# so this needs the domain first. See src/lib/email.ts.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# e.g. Deadeye <no-reply@deadeye.ie>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------
# Contact address shown on the terms/privacy/settings pages. Falls back to OWNER_EMAIL.
SUPPORT_EMAIL=
# Fallback timezone for "today"/"this week" when a player has none set. Defaults to Europe/Dublin.
APP_TIME_ZONE=Europe/Dublin
# Only needed if shipping the PWA as an Android TWA (serves .well-known/assetlinks.json)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
